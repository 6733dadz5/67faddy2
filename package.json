{
  "name": "aerodrome",
  "productName": "Aerodrome",
  "version": "1.0.0",
  "description": "Aerodrome flight simulator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --win portable dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.aerodrome.sim",
    "productName": "Aerodrome",
    "files": ["main.js", "game/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["portable", "dir"] }, "portable": { "artifactName": "Aerodrome.exe" }
  }
}
